generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime
  User              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Availability {
  id             String       @id
  tutorProfileId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  createdAt      DateTime     @default(now())
  TutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@index([tutorProfileId])
}

model Booking {
  id                           String        @id
  studentId                    String
  tutorId                      String
  tutorProfileId               String
  dateTime                     DateTime
  duration                     Int           @default(60)
  status                       BookingStatus @default(PENDING)
  totalPrice                   Float
  notes                        String?
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime
  User_Booking_studentIdToUser User          @relation("Booking_studentIdToUser", fields: [studentId], references: [id], onDelete: Cascade)
  User_Booking_tutorIdToUser   User          @relation("Booking_tutorIdToUser", fields: [tutorId], references: [id], onDelete: Cascade)
  TutorProfile                 TutorProfile  @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  Payment                      Payment?
  Review                       Review?

  @@index([dateTime])
  @@index([studentId])
  @@index([tutorId])
}

model Conversation {
  id                                     String    @id
  participant1Id                         String
  participant2Id                         String
  lastMessageAt                          DateTime?
  createdAt                              DateTime  @default(now())
  updatedAt                              DateTime
  User_Conversation_participant1IdToUser User      @relation("Conversation_participant1IdToUser", fields: [participant1Id], references: [id], onDelete: Cascade)
  User_Conversation_participant2IdToUser User      @relation("Conversation_participant2IdToUser", fields: [participant2Id], references: [id], onDelete: Cascade)
  Message                                Message[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
}

model Favorite {
  studentId String
  tutorId   String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, tutorId])
  @@index([studentId])
}

model Message {
  id             String       @id
  conversationId String
  senderId       String
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  Conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model Payment {
  id        String   @id
  bookingId String   @unique
  amount    Float
  status    String   @default("MOCK_SUCCESS")
  method    String   @default("MOCK")
  createdAt DateTime @default(now())
  Booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Review {
  id                          String   @id
  bookingId                   String   @unique
  studentId                   String
  tutorId                     String
  rating                      Int
  comment                     String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime
  Booking                     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  User_Review_studentIdToUser User     @relation("Review_studentIdToUser", fields: [studentId], references: [id], onDelete: Cascade)
  User_Review_tutorIdToUser   User     @relation("Review_tutorIdToUser", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([tutorId])
}

model Session {
  sessionToken String   @id @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subject {
  id           String         @id
  name         String         @unique
  slug         String         @unique
  icon         String?
  createdAt    DateTime       @default(now())
  TutorSubject TutorSubject[]
}

model TutorProfile {
  id                String         @id
  userId            String         @unique
  bio               String?
  hourlyRate        Float          @default(20.0)
  introVideoUrl     String?
  languages         String[]
  teachingApproach  String?
  isApproved        Boolean        @default(true)
  nationality       String?
  yearsOfExperience Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  Availability      Availability[]
  Booking           Booking[]
  User              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  TutorSubject      TutorSubject[]
}

model TutorSubject {
  tutorProfileId String
  subjectId      String
  createdAt      DateTime     @default(now())
  Subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  TutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  @@id([tutorProfileId, subjectId])
}

model User {
  id                                             String         @id
  name                                           String
  email                                          String         @unique
  password                                       String
  role                                           Role           @default(STUDENT)
  image                                          String?
  createdAt                                      DateTime       @default(now())
  updatedAt                                      DateTime
  Account                                        Account[]
  Booking_Booking_studentIdToUser                Booking[]      @relation("Booking_studentIdToUser")
  Booking_Booking_tutorIdToUser                  Booking[]      @relation("Booking_tutorIdToUser")
  Conversation_Conversation_participant1IdToUser Conversation[] @relation("Conversation_participant1IdToUser")
  Conversation_Conversation_participant2IdToUser Conversation[] @relation("Conversation_participant2IdToUser")
  Favorite                                       Favorite[]
  Message                                        Message[]
  Review_Review_studentIdToUser                  Review[]       @relation("Review_studentIdToUser")
  Review_Review_tutorIdToUser                    Review[]       @relation("Review_tutorIdToUser")
  Session                                        Session[]
  TutorProfile                                   TutorProfile?
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum Role {
  STUDENT
  TUTOR
  ADMIN
}
